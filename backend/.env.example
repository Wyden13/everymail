# Copy to backend/.env, which Bun loads when the Backend runs from backend/ (bun run dev:backend)

# Postgres; the default is the one `docker compose up -d` starts
DATABASE_URL=postgres://postgres:everymail@localhost:5432/everymail

# The origin the sign-in callback is served from. In development it is the web dev server, which proxies /api.v1. and /auth/ here
PUBLIC_ORIGIN=http://localhost:5173

# Google sign-in client (required). Its authorized redirect URI must be http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft sign-in client (optional): Microsoft is offered only once its client id is set
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Port the Backend listens on (optional, default 8787; the dev proxies expect 8787)
PORT=8787
